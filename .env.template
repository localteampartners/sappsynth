# sappsynth — sappvault injection template
#
# This file is consumed by `sappvault inject .env.template .env`.
# Secrets use ${vault:NAME} placeholders; plain config stays plain.
# Commit this file. Add `.env` to `.gitignore`.
#
# To bootstrap:    sappvault setup            (prompts for missing values)
# To regenerate:   sappvault inject .env.template .env
# To inspect:      sappvault list             (names only, never values)

# --- Secrets (lived in macOS Keychain via sappvault) ---
# Uncomment + rename per your stack. Each placeholder pulls its value from
# Keychain under service "sappvault:sappsynth".
#
# EXAMPLE_API_KEY=${vault:EXAMPLE_API_KEY}
# DATABASE_URL=${vault:DATABASE_URL}
# STRIPE_SECRET_KEY=${vault:STRIPE_SECRET_KEY}

# --- Non-secret config (commit real values) ---
# LOG_LEVEL=info
# PORT=3000
